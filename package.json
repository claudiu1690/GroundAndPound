{
  "name": "mma-game",
  "version": "2.0.0",
  "description": "Ground & Pound: Chronicles of the Cage — MMA career RPG backend",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "start:local": "cross-env LOCAL_MODE=true node app.js",
    "start:remote": "cross-env LOCAL_MODE=false node app.js",
    "dev": "nodemon app.js --inspect",
    "dev:local": "cross-env LOCAL_MODE=true nodemon app.js --inspect",
    "dev:remote": "cross-env LOCAL_MODE=false nodemon app.js --inspect",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed": "node scripts/seed.js",
    "seed:local": "cross-env LOCAL_MODE=true node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "seed:opponents": "node scripts/seedOpponents.js",
    "seed:opponents:reset": "node scripts/seedOpponents.js --reset",
    "seed:gyms": "node scripts/seedGyms.js",
    "seed:gyms:reset": "node scripts/seedGyms.js --reset",
    "stats": "node scripts/stats.js",
    "stats:local": "cross-env LOCAL_MODE=true node scripts/stats.js",
    "debug:energy": "node scripts/debugRechargeEnergy.js",
    "debug:reset-fight-cap": "node scripts/debugResetDailyFightCap.js",
    "debug:title-shot": "node scripts/debugTitleShot.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mma",
    "rpg",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.59.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^4.18.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "resend": "^6.12.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.0"
  }
}
