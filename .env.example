# Ground & Pound — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ═══════════════════════════════════════════════════════════════
#  MASTER SWITCH
# ═══════════════════════════════════════════════════════════════
# LOCAL_MODE=true  → use local Mongo + local Redis (overrides all URLs below).
# LOCAL_MODE=false → use remote (Atlas + your hosted Redis).
# On deployed hosts (Railway, Render, etc.) leave this unset so the platform's
# MONGODB_URI / REDIS_URL env vars take effect.
LOCAL_MODE=true

# ═══════════════════════════════════════════════════════════════
#  MONGO
# ═══════════════════════════════════════════════════════════════
MONGODB_URI_LOCAL=mongodb://localhost:27017/mmaGame
MONGODB_URI_ATLAS=mongodb+srv://<user>:<password>@<cluster>/mmaGame?appName=<app>

# When LOCAL_MODE=false, set USE_ATLAS=true to use the Atlas URI above.
USE_ATLAS=false

# Optional explicit override (server / CI).
# MONGODB_URI=

# ═══════════════════════════════════════════════════════════════
#  REDIS  (BullMQ workers)
# ═══════════════════════════════════════════════════════════════
REDIS_URL_LOCAL=redis://127.0.0.1:6379

# Optional explicit override. Railway / Upstash inject this directly.
# Use rediss:// for TLS endpoints.
# REDIS_URL=

# ═══════════════════════════════════════════════════════════════
#  AUTH
# ═══════════════════════════════════════════════════════════════
JWT_SECRET=replace_me_with_a_long_random_string

# ═══════════════════════════════════════════════════════════════
#  SERVER
# ═══════════════════════════════════════════════════════════════
PORT=4001
