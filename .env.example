# Ground & Pound — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ═══════════════════════════════════════════════════════════════
#  MASTER SWITCH
# ═══════════════════════════════════════════════════════════════
# LOCAL_MODE=true  → use local Mongo + local Redis (overrides all URLs below).
# LOCAL_MODE=false → use remote (Atlas + your hosted Redis).
# On deployed hosts (Railway, Render, etc.) leave this unset so the platform's
# MONGODB_URI / REDIS_URL env vars take effect.
LOCAL_MODE=true

# ═══════════════════════════════════════════════════════════════
#  MONGO
# ═══════════════════════════════════════════════════════════════
MONGODB_URI_LOCAL=mongodb://localhost:27017/mmaGame
MONGODB_URI_ATLAS=mongodb+srv://<user>:<password>@<cluster>/mmaGame?appName=<app>

# When LOCAL_MODE=false, set USE_ATLAS=true to use the Atlas URI above.
USE_ATLAS=false

# Optional explicit override (server / CI).
# MONGODB_URI=

# ═══════════════════════════════════════════════════════════════
#  REDIS  (BullMQ workers)
# ═══════════════════════════════════════════════════════════════
REDIS_URL_LOCAL=redis://127.0.0.1:6379

# Optional explicit override. Railway / Upstash inject this directly.
# Use rediss:// for TLS endpoints.
# REDIS_URL=

# ═══════════════════════════════════════════════════════════════
#  AUTH
# ═══════════════════════════════════════════════════════════════
JWT_SECRET=replace_me_with_a_long_random_string

# ═══════════════════════════════════════════════════════════════
#  SERVER
# ═══════════════════════════════════════════════════════════════
PORT=4001

# ═══════════════════════════════════════════════════════════════
#  ACCOUNT PAGE — emails + redirect URLs
# ═══════════════════════════════════════════════════════════════
# Public-facing URL of the frontend. Used in:
#   • password-reset email link  → ${APP_URL}/?reset_password_token=...
#   • email-change confirmation redirect on success/failure
# Localhost dev: leave as 5173 (Vite default).
# Production: set to your Vercel/Netlify URL, e.g. https://groundandpound.app
APP_URL=http://localhost:5173

# Public-facing BACKEND URL — used inside the email-verify and email-change
# confirmation links (click-once flows where the link must hit the backend
# directly, then redirect to the frontend with a status param).
# Localhost dev: same host, port 4001. Production: your Railway public URL.
BACKEND_URL=http://localhost:4001

# Resend transactional-email API. Sign up at https://resend.com → API Keys.
# When unset, transactional emails fall back to a console.log (the rest of the
# app still works — the link just isn't delivered). Plug the real key in here
# in production.
RESEND_API_KEY=

# From-address used by the Resend client. Must be a verified domain on Resend,
# OR Resend's onboarding sender (onboarding@resend.dev) for initial testing.
EMAIL_FROM=Ground & Pound <onboarding@resend.dev>

# Recipient for "Report a Bug" notifications. Falls back to EMAIL_FROM when unset.
BUG_REPORT_EMAIL=
# Optional: reports per 10 min per IP (default 5).
# BUG_REPORT_RATE_LIMIT_MAX=5

# Optional — frontend origin used for CORS allow-list. Comma-separate multiple.
# Leave unset to default to the APP_URL above.
# FRONTEND_URL=https://groundandpound.app

# Sentry error monitoring. Create a Node.js project at sentry.io (free Developer
# plan) — or any Sentry-compatible backend like GlitchTip — and paste its DSN
# here / in Railway. When unset, error monitoring is disabled (the app runs
# identically, errors just aren't reported).
SENTRY_DSN=

# Rate limiting (optional overrides). Defaults: 300 req/min/IP global,
# 50 attempts/15min/IP on /auth.
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=50

# ═══════════════════════════════════════════════════════════════
#  ANALYTICS (internal telemetry)
# ═══════════════════════════════════════════════════════════════
# Comma-separated list of user emails allowed to read /admin/analytics/*
ANALYTICS_ADMIN_EMAILS=
