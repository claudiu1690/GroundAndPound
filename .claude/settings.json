{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-prod.js\"",
            "timeout": 10,
            "statusMessage": "Checking for production access"
          }
        ]
      }
    ]
  }
}
