{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:local"
      ],
      "port": 4001
    },
    {
      "name": "backend-retired",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local:retired"
      ],
      "port": 4001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "camp-p2-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "4173",
        "--strictPort",
        "--mode",
        "p2verify"
      ],
      "port": 4173
    },
    {
      "name": "mockups",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "mockups",
        "-p",
        "4599",
        "-c-1",
        "--silent"
      ],
      "port": 4599
    }
  ]
}
