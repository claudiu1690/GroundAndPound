{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:local"
      ],
      "port": 4001
    },
    {
      "name": "backend-retired",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:local:retired"
      ],
      "port": 4001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "camp-p2-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "4173",
        "--strictPort",
        "--mode",
        "p2verify"
      ],
      "port": 4173
    },
    {
      "name": "mockups",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "mockups",
        "-p",
        "4599",
        "-c-1",
        "--silent"
      ],
      "port": 4599
    },
    {
      "name": "backend-home",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:local"
      ],
      "autoPort": true
    },
    {
      "name": "backend-4102",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "LOCAL_MODE=true",
        "PORT=4102",
        "node",
        "app.js"
      ],
      "port": 4102
    },
    {
      "name": "frontend-4173",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "VITE_API_URL=http://localhost:4102",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "e2e-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "LOCAL_MODE=true",
        "PORT=4101",
        "MONGODB_URI_LOCAL=mongodb://localhost:27017/mmaGameE2E",
        "REDIS_URL_LOCAL=redis://127.0.0.1:6379",
        "FRONTEND_URL=http://localhost:5273",
        "GUEST_CREATE_RATE_LIMIT_MAX=1000000",
        "RATE_LIMIT_MAX=1000000",
        "node",
        "app.js"
      ],
      "port": 4101
    },
    {
      "name": "e2e-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "VITE_API_URL=http://localhost:4101",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5273",
        "--strictPort"
      ],
      "port": 5273
    }
  ]
}
